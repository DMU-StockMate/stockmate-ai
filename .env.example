# 이 AI 서버의 인증 키. 외부 노출 시 필수, 로컬 개발은 비워둠
AI_API_KEY=

# LLM 백엔드: ollama | openai (llama.cpp llama-server 등 OpenAI 호환 서버)
LLM_BACKEND=ollama
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=
LLM_MODEL=qwen3.5:9b
# Qwen3.8 계열의 사고 강도 (max|xhigh|high|medium|low|minimal|none).
# 지정하지 않으면 기본이 xhigh 라 과하게 오래 생각한다.
LLM_REASONING_EFFORT=medium
# 채팅(/chat/stream) 전용. 퀴즈와 분리돼 있다.
# 퀴즈는 medium 유지(용어 정확도), 채팅은 none - 스트리밍이라 사고 구간에는
# content 가 빈 문자열로 와서 사용자가 그동안 아무것도 못 본다.
# 실측(같은 질문): 첫 글자까지 medium 6.1초 / none 1.4초, 빈 청크 19% -> 1%.
CHAT_REASONING_EFFORT=none
OLLAMA_BASE_URL=http://localhost:11434
# LLM
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=stock-model

# Vector DB
# CHROMA_PERSIST_DIR=./chroma_storage
# EMBEDDING_MODEL=BAAI/bge-m3

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=

# 퀴즈 뱅크 (생성된 문제를 저장해 요청 간 중복을 막는다 - RAG 컬렉션과 분리)
# QUIZ_BANK_ENABLED=false 로 두면 중복 검사 없이 동작한다 (Qdrant 없이 개발할 때)
QUIZ_BANK_COLLECTION=quiz_bank
QUIZ_BANK_ENABLED=true
# 코사인 유사도 임계값 (bge-m3 실측 기반. scripts/check_quiz_bank.py 로 분포 확인 가능)
# 낮출수록 중복 판정이 엄격해져 재생성이 잦아진다.
QUIZ_DUP_THRESHOLD=0.83
# 과거 요청에서 만든 문제와도 대조할지. false = 이번 요청 안에서만 중복을 막는다.
# true 로 하면 같은 유저가 예전에 받은 문제와도 겹치지 않게 되지만, 문항마다
# Qdrant 왕복이 붙고 뱅크가 쌓일수록 재생성이 잦아진다.
QUIZ_DUP_CHECK_PAST=false
# 한 요청 안에서 문제를 몇 개까지 동시에 생성할지 (요청 단위 상한).
QUIZ_GEN_CONCURRENCY=5
# 한 번의 LLM 호출로 만들 문제 수 상한. 하나씩 병렬로 만들면 서로를 못 봐서
# 중복이 심하다(2026-09-08 측정: 같은 주제 3문제 기준 중복 발동률 77%).
# 한 번에 쓰게 하면 모델이 나란히 놓고 쓰므로 사라진다. 출력 토큰 때문에 상한을 둔다.
QUIZ_BATCH_MAX=3
# 묶음 생성에서 문제가 하나 늘 때마다 더해줄 출력 토큰.
# 3개 묶음이 LLM_MAX_TOKENS(4096)에 닿아 JSON 이 잘리고 500 이 났다(실측).
QUIZ_BATCH_TOKENS_PER_ITEM=900
# /quiz/generate/prompt 에서 개수 언급이 없을 때 만들 문제 수.
# 5 -> 3 (2026-09-05). 5개가 파드 실측 84.9초인데 프록시가 100초에서 끊는다.
PROMPT_QUIZ_DEFAULT_COUNT=3
# 세트 검증(LLM 1회)을 어떻게 돌릴지: blocking | background | off
# 계측(2026-09-08): 프롬프트 퀴즈 3문제 81.5초 중 이 단계가 24.7초(30%).
# 그날 모든 케이스가 "전체 합격"이라 background 로 뺐다 - 지연은 사라지고
# 불합격 로그는 계속 쌓인다. GPU 작업량은 안 줄므로 처리량이 문제면 off.
QUIZ_VALIDATE_MODE=background
# 프롬프트 분석 단계 전용 사고 강도.
# none 은 쓰지 말 것 - 카탈로그에 없는 주제를 못 옮겨 422 가 난다
# (2026-09-08 파드: 동시 20명 중 5건 실패. 강도별 30건 재측정 none 13/30,
#  minimal/low/medium 각 30/30, 지연 차이는 관측 안 됨).
ANALYZE_REASONING_EFFORT=low

# ── 하트비트 응답 (Cloudflare 100초 벽 우회) ──
# RunPod HTTP 프록시는 응답 첫 바이트까지 100초를 기다린 뒤 524 로 끊는다.
# 켜 두면 오래 걸리는 응답에 공백을 흘려보내 그 벽을 없앤다. JSON 값 앞의
# 공백은 문법상 무시되므로 백엔드 코드/스키마는 그대로다. 배경은 app/core/keepalive.py.
RESPONSE_KEEPALIVE_ENABLED=true
# 첫 박동까지 대기. 이 안에 끝나면 응답은 예전과 완전히 동일하고 422/500 도 정상.
RESPONSE_KEEPALIVE_DELAY_SEC=30
# 박동 간격.
RESPONSE_KEEPALIVE_INTERVAL_SEC=10

# External APIs
DART_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 현재 시세 api
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT=

# HuggingFace 토큰
HF_TOKEN=